# --- Telegram ---
# Token from @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Comma-separated numeric Telegram user ids that may use /admin
ADMIN_IDS=11111111
# "polling" for local/dev, "webhook" for production
BOT_MODE=polling

# --- Public HTTP server (payment callbacks) ---
# Must be reachable from the internet over HTTPS for Crypto Pay / OxaPay callbacks.
# For local testing use a tunnel (cloudflared, ngrok) and put the public https URL here.
PUBLIC_BASE_URL=https://your-domain.example.com
# When BOT_MODE=webhook, Telegram posts updates to {PUBLIC_BASE_URL}/telegram/webhook
WEBHOOK_SECRET=change-me-to-a-long-random-string
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# --- Database ---
# SQLite by default. For Postgres: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/shop.db

# --- Telegram Stars ---
# Stars need no provider token; leave enabled to sell digital goods for XTR.
STARS_ENABLED=true

# --- Crypto Pay (@CryptoBot) ---
# Open @CryptoBot -> Crypto Pay -> Create App -> copy the API token.
CRYPTOPAY_ENABLED=false
CRYPTOPAY_TOKEN=
# Use https://testnet-pay.crypt.bot for the testnet app (@CryptoTestnetBot)
CRYPTOPAY_BASE_URL=https://pay.crypt.bot
# Optional: secret path segment appended to the callback URL, e.g. /webhooks/cryptopay/<secret>
CRYPTOPAY_WEBHOOK_SECRET=

# --- OxaPay ---
# OxaPay dashboard -> Merchant API -> generate a Merchant API Key.
OXAPAY_ENABLED=false
OXAPAY_API_KEY=
OXAPAY_BASE_URL=https://api.oxapay.com
# Set true to create invoices in OxaPay sandbox mode
OXAPAY_SANDBOX=false

# --- Background reconciliation ---
# Polls providers for orders left pending, to survive lost webhooks.
RECONCILE_INTERVAL_SECONDS=60
# Orders younger than this are skipped (give the provider time to notify us).
RECONCILE_MIN_AGE_SECONDS=120
# Stop polling an order after this long and mark it expired.
ORDER_EXPIRY_MINUTES=120

LOG_LEVEL=INFO
